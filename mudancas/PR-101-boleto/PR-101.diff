 export const PARCELA_MINIMA = 20.0;
+export const DIAS_VENCIMENTO_BOLETO = 3;
+
+export const FORMAS_DE_PAGAMENTO = {
+  cartao: 'Cartão de crédito',
+  pix: 'PIX',
+  boleto: 'Boleto bancário'
+};
+
+/** Data de vencimento do boleto: 3 dias úteis após a emissão (US-09). */
+export function calcularVencimentoBoleto(emissao = new Date()) {
+  const vencimento = new Date(emissao);
+  vencimento.setDate(vencimento.getDate() + DIAS_VENCIMENTO_BOLETO);
+  return vencimento;
+}
+
+/** Linha digitável fake (47 dígitos) — o banco real será integrado na v1.6. */
+export function gerarLinhaDigitavel(pedidoId, total) {
+  const valor = String(Math.round(total * 100)).padStart(10, '0');
+  const base = `34191790010104351004791020150008${String(pedidoId).padStart(5, '0')}${valor}`;
+  return base.slice(0, 47).replace(/(\d{5})(\d{5})(\d{5})(\d{6})(\d{5})(\d{6})(\d)(\d{14})/, '$1.$2 $3.$4 $5.$6 $7 $8');
+}
 
 export function calcularDescontoPix(valorBase) {
   return arredondar(valorBase * DESCONTO_PIX);
