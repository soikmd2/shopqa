{
  "name": "shopqa",
  "private": true,
  "version": "1.4.0",
  "description": "Loja virtual de demonstração do curso IA para QAs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bg": "node scripts/servidor.mjs iniciar",
    "dev:stop": "node scripts/servidor.mjs parar",
    "build": "vite build",
    "preview": "vite preview",
    "test:regras": "node --test \"tests/regras/**/*.test.js\"",
    "casos:exportar": "node scripts/exportar-casos.mjs",
    "hooks:testar": "node guardrails/testar-hook.mjs",
    "guardrails:instalar": "node guardrails/instalar.mjs",
    "desafios:corrigir": "node --test \"desafios/**/corretor.test.mjs\"",
    "aula:resetar": "node scripts/resetar-aula.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^6.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
